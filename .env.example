# Contoh konfigurasi. Salin jadi `.env` lalu isi nilainya.
# `.env` sudah masuk .gitignore dan TIDAK boleh di-commit (repo ini publik).

# API key NASA FIRMS untuk mengunduh hotspot NRT.
# Daftar gratis di https://firms.modaps.eosdis.nasa.gov/api/map_key/
# JANGAN tulis key asli di berkas ini, di kode, atau di dokumen.
FIRMS_MAP_KEY=

# Wilayah yang diambil. Indonesia = "IDN" pada API area FIRMS.
FIRMS_AREA=IDN

# Sensor. NOAA20 dipakai proyek ini sejak awal.
FIRMS_SOURCE=VIIRS_NOAA20_NRT
